{
  "display_information": {
    "name": "Studio Shots",
    "description": "Telegram-first styled product photography for catalog teams. Slack foundation for mentions and future workflows.",
    "background_color": "#6b5b95"
  },
  "features": {
    "bot_user": {
      "display_name": "Studio Shots",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://your-vercel-deployment.vercel.app/api/slack/events",
      "bot_events": [
        "app_mention"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
