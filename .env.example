# Copy to .env.local and fill in the values for a fresh Studio Shots deployment.

APP_URL=https://your-vercel-deployment.vercel.app
DATABASE_URL=postgres://...
TELEGRAM_BOT_TOKEN=123456:ABCDEF
TELEGRAM_WEBHOOK_SECRET=replace_with_32_plus_chars
ALLOWED_CHAT_ID=-1001234567890

# Luma Agents API key for image generation.
# Required when IMAGE_GENERATION_PROVIDER=luma (production).
# Not required when IMAGE_GENERATION_PROVIDER=fake (local / Preview testing).
LUMA_AGENTS_API_KEY=luma-api-...

# Image generation provider: "luma" (paid) or "fake" (demo images, no Luma calls).
# Local / Preview: IMAGE_GENERATION_PROVIDER=fake
# Production: IMAGE_GENERATION_PROVIDER=luma
# Fake mode is refused when VERCEL_ENV=production.
IMAGE_GENERATION_PROVIDER=fake

# Slack (single-workspace install; no OAuth multi-workspace).
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=replace_with_slack_signing_secret
SLACK_TEAM_ID=T0123456789
SLACK_CHANNEL_ID=C0123456789
